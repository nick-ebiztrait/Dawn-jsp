{% if article.metafields.custom.faq_json != blank %}
  {% assign faqs = article.metafields.custom.faq_json.value %}
  {% comment %} <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": {{ faq.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ faq.answer | json }}
        }
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script> {% endcomment %}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What kind of products do you sell?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We specialize in thoughtfully curated kitchen products that combine quality, style, and functionality. Our collection includes kitchen tools, gadgets, cookware, storage solutions, and eco-friendly essentials—everything designed to make your cooking and home experience more enjoyable."
      }
    },
    {
      "@type": "Question",
      "name": "Are your products family-friendly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! As a family-run business, we select products that are practical, safe, and perfect for households of all sizes. Whether you're cooking with kids or hosting a family gathering, our products are meant to support moments that bring loved ones together."
      }
    },
    {
      "@type": "Question",
      "name": "Where do you ship?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We currently ship across the United States, with plans to expand internationally in the near future. All orders are shipped from our base in Massachusetts with care and attention to detail."
      }
    },
    {
      "@type": "Question",
      "name": "How long does shipping take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard shipping typically takes 3–7 business days, depending on your location. You'll receive tracking information as soon as your order is on its way. Expedited options may be available at checkout."
      }
    },
    {
      "@type": "Question",
      "name": "Can I return or exchange a product?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We want you to love your purchase! If you're not satisfied, you can return or exchange most items within 30 days of delivery. Products must be unused and in their original packaging. For more information, visit our Returns & Exchanges page."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer gift wrapping or custom messages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We do! Many of our items can be gift-wrapped at checkout, and you can include a personal message for your recipient. It's a great way to send a thoughtful kitchen gift to friends or family."
      }
    },
    {
      "@type": "Question",
      "name": "Are your products eco-friendly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We're proud to offer a growing selection of eco-conscious kitchen products, including reusable tools, sustainable materials, and plastic-free packaging wherever possible. We're committed to doing our part for a healthier planet."
      }
    },
    {
      "@type": "Question",
      "name": "How can I contact you?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We'd love to hear from you! You can reach us anytime through our Contact Us page or email us at junior.patino@jspltdenterprises.com. We aim to respond within 24–48 hours."
      }
    }
  ]
}
</script>
{% endif %}
